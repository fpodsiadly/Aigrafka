{
  "functions": {
    "api/payments/webhook.ts": {
      "runtime": "nodejs18",
      "maxDuration": 10,
      "memory": 256
    },
    "api/cron/worker.ts": {
      "runtime": "nodejs18",
      "maxDuration": 10,
      "memory": 512
    }
  },
  "routes": [
    {
      "src": "/api/payments/webhook",
      "dest": "/api/payments/webhook.ts",
      "methods": ["POST"],
      "headers": { "x-vercel-prefer-native": "1" }
    }
  ]
}
