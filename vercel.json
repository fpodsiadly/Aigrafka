{
  "functions": {
    "api/payments/webhook.ts": {
      "runtime": "nodejs18.x",
      "maxDuration": 10,
      "memory": 256
    },
    "api/cron/worker.ts": {
      "runtime": "nodejs18.x",
      "maxDuration": 10,
      "memory": 512
    }
  },
  "routes": [
    {
      "src": "/api/payments/webhook",
      "dest": "/api/payments/webhook.ts",
      "methods": ["POST"],
      "headers": { "x-vercel-prefer-native": "1" }
    }
  ],
  "/* CRON_DISABLED": "Hobby plan Vercel nie obsługuje cron jobs. AI worker będzie nieruchomy do upgradu Pro.",
  "/* OPTION_3": "Alternatywa: skonfiguruj zewnętrzny serwis (cron-job.org, EasyCron, itp.) by pingował /api/cron/worker co 2 min",
  "/* FUTURE_CRONS": {
    "crons": [
      {
        "path": "/api/cron/worker",
        "schedule": "*/2 * * * *"  
      }
    ]
  }
}
