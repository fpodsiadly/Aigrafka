# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
PGHOST=host
PGHOST_UNPOOLED=host
PGUSER=user
PGDATABASE=dbname
PGPASSWORD=password

# Vercel Postgres templates (optional aliases)
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_URL_NO_SSL=postgresql://user:password@host/dbname
POSTGRES_PRISMA_URL=postgresql://user:password@host/dbname?connect_timeout=15&sslmode=require
POSTGRES_USER=user
POSTGRES_HOST=host
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=dbname

# Redis (Vercel Redis integration)
REDIS_URL=redis://default:password@host:port

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_xxx
PRICE_STARTER_CENTS=1000
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
CHECKOUT_SUCCESS_URL=https://example.com/success
CHECKOUT_CANCEL_URL=https://example.com/cancel
STRIPE_DEMO_MODE=false

# Auth/JWT
JWT_SECRET=change_me

# Cron worker auth (optional)
CRON_SECRET=change_me

# API base for extension build (subdomena API)
VITE_API_BASE=https://aigrafka.onrender.com

# FastAPI CORS (lista originów po przecinku)
CORS_ORIGINS=https://aigrafka.onrender.com,https://aigrafka.pl,https://api.aigrafka.pl,http://localhost:5173

# AI / Banana (when available)
BANANA_URL=https://api.banana.dev/...
