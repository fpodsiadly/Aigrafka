{
  "name": "aigrafka-extension",
  "version": "0.2.20",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.content.config.ts && vite build",
    "postbuild": "cp manifest.json dist/manifest.json && cp -R icons dist/icons",
    "lint": "echo 'add lint'",
    "release:patch": "cd .. && bash scripts/build-and-release.sh patch",
    "release:minor": "cd .. && bash scripts/build-and-release.sh minor",
    "release:major": "cd .. && bash scripts/build-and-release.sh major"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.10"
  }
}
