{
  "name": "aigrafka-extension",
  "version": "0.2.29",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.content.config.ts && vite build",
    "postbuild": "node -e \"const fs=require('fs'); fs.cpSync('manifest.json','dist/manifest.json'); fs.cpSync('icons','dist/icons',{recursive:true});\" && python3 scripts/package_extension.py",
    "package": "npm run build",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "release:patch": "cd .. && bash scripts/build-and-release.sh patch",
    "release:minor": "cd .. && bash scripts/build-and-release.sh minor",
    "release:major": "cd .. && bash scripts/build-and-release.sh major"
  },
  "dependencies": {
    "preact": "^10.29.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.10"
  }
}
